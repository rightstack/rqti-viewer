# 토큰은 ~/.npmrc 한 줄. 레포에 커밋하지 않는다. 값은 사내 문의 (장가영).
# 설치 → read / 배포 → write (write는 read 포함)
#   echo '//npm.pkg.github.com/:_authToken=ghp_...' >> ~/.npmrc
#   grep 'npm.pkg.github.com' ~/.npmrc
# 이미 있으면 echo 반복 금지. 배포 시 값을 write 로 교체.

@rightstack:registry=https://npm.pkg.github.com

# 모노레포에서 playground가 GitHub Packages 배포본만 쓰려면:
# link-workspace-packages=false
# (로컬 packages/viewer 개발 시에는 설정하지 않음 — workspace:* 사용)
